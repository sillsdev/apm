{
  "name": "audio-project-manager",
  "version": "4.5.1",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "homepage": "./out",
  "scripts": {
    "clean": "rimraf dist out src/renderer/dist src/renderer/coverage",
    "stamp": "node env-config/writeDate.cjs",
    "logoassets": "node env-config/genLogoAssets.cjs",
    "format": "prettier --config .prettierrc.yaml --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "serve": "electron-vite preview",
    "start": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "devs": "node env-config/changeEnv.cjs dev",
    "qas": "node env-config/changeEnv.cjs qa",
    "prods": "node env-config/changeEnv.cjs prod",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.24.1",
    "@bugsnag/js": "^8.10.0",
    "@bugsnag/plugin-react": "^8.9.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/notarize": "^2.5.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@fontsource/roboto": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/x-data-grid": "^8.29.3",
    "@mui/x-tree-view": "^8.29.3",
    "@orbit/coordinator": "^0.17.0",
    "@orbit/core": "^0.17.0",
    "@orbit/indexeddb": "^0.17.2",
    "@orbit/indexeddb-bucket": "^0.17.0",
    "@orbit/jsonapi": "^0.17.1",
    "@orbit/memory": "^0.17.2",
    "@orbit/records": "^0.17.0",
    "@orbit/serializers": "^0.17.0",
    "@uiw/react-color-colorful": "^2.10.3",
    "@wavesurfer/react": "^1.0.12",
    "@xmldom/xmldom": "^0.8.11",
    "adm-zip": "^0.6.0",
    "array-move": "^4.0.0",
    "audio-recorder-polyfill": "^0.4.1",
    "axios": "^1.19.0",
    "browser-image-compression": "^2.0.2",
    "electron-updater": "^6.8.9",
    "execa": "^9.6.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fs-extra": "^11.4.0",
    "jszip": "^3.10.1",
    "jwt-decode": "^4.0.0",
    "keytar": "^7.9.0",
    "lodash": "^4.18.1",
    "luxon": "^3.7.2",
    "md5-file": "^5.0.0",
    "mui-language-picker": "^2.7.5",
    "node-stream-zip": "^1.16.0",
    "react-datasheet": "^1.4.12",
    "react-draggable": "^4.7.1",
    "react-file-drop": "^3.1.6",
    "react-icons": "^5.7.0",
    "react-localization": "^2.0.6",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.2",
    "react-select": "^5.10.2",
    "react-string-replace": "^1.1.1",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "remark-gfm": "^4.0.1",
    "request": "^2.88.2",
    "styled-components": "^6.5.3",
    "url-parse": "^1.5.10",
    "wavesurfer.js": "^7.12.11",
    "xml-js": "^1.6.11",
    "xpath": "^0.0.34"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "exclude": [
      "node_modules",
      "dist",
      "build",
      "out"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.62.1",
    "@types/adm-zip": "^0.5.8",
    "@types/execa": "^0.9.0",
    "@types/ffmpeg-static": "^3.0.3",
    "@types/ffprobe-static": "^2.0.3",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-redux": "^7.1.34",
    "@types/react-router-dom": "^5.3.3",
    "@types/request": "^2.48.13",
    "@types/wavesurfer.js": "^6.0.12",
    "@upstash/context7-mcp": "^2.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "dotenv": "^17.4.2",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.7",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "prettier": "^3.9.6",
    "puppeteer": "^24.43.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "write": "^2.0.0"
  },
  "author": {
    "name": "SIL Global",
    "email": "info@sil.org",
    "url": "http://sil.org"
  },
  "build": {
    "appId": "sil.lsdev.audio-project-manager",
    "productName": "Audio Project Manager",
    "copyright": "Copyright © 2020-2026 ${author}",
    "win": {
      "icon": "resources/icon.png"
    },
    "linux": {
      "icon": "debian/audio-project-manager.png",
      "executableName": "audio-project-manager",
      "desktop": {
        "entry": {
          "Type": "Application",
          "Encoding": "UTF-8",
          "Name": "Audio Project Manager",
          "Name[fr]": "Audio Project Manager",
          "Comment": "Flexible audio-text orality solution",
          "Comment[fr]": "Solution flexible d'oralité audio-textuelle",
          "Icon": "audio-project-manager",
          "Categories": "GTK;GNOME;Education;Utility;",
          "Keywords": "audio;obt;transcribe;ai",
          "Terminal": "false"
        }
      },
      "target": "deb"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "resources/icon.png",
      "hardenedRuntime": true,
      "entitlements": "env-config/entitlements.mac.plist",
      "entitlementsInherit": "env-config/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Please give us access to your microphone"
      }
    },
    "dmg": {
      "sign": false
    },
    "afterSign": "./env-config/notarize.js",
    "directories": {
      "buildResources": "assets"
    },
    "extraResources": [
      {
        "from": "migration",
        "to": "migration",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraFiles": [
      {
        "from": "./src/renderer/public/localization",
        "to": "localization",
        "filter": "*.json"
      },
      {
        "from": "./src/renderer/public/help",
        "to": "help",
        "filter": "*.chm"
      },
      {
        "from": "./src/renderer/public/help",
        "to": "help",
        "filter": "*.xlsx"
      },
      {
        "from": "./src/renderer/public/script",
        "to": "resources",
        "filter": [
          "resetData.*",
          "*.py",
          "*.aup3"
        ]
      }
    ]
  },
  "volta": {
    "node": "22.23.2",
    "npm": "12.0.2"
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "ffmpeg-static@5.3.0": true,
    "keytar@7.9.0": true,
    "puppeteer@24.43.1": true,
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true,
    "browser-tabs-lock@1.3.0": true
  }
}
