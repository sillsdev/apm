{
  "name": "apm-vite-web",
  "version": "4.7.0",
  "license": "MIT",
  "scripts": {
    "start": "vite",
    "build": "tsc -p tsconfig.app.json --composite false && vite build",
    "serve": "vite preview",
    "bugsnag:upload": "cd .. && node env-config/bugsnagUpload.cjs",
    "test": "jest",
    "test:ci": "jest --ci --verbose --maxWorkers=1 --no-cache",
    "test:smoke": "jest --config jest.smoke.config.ts",
    "test:smoke:ci": "jest --ci --maxWorkers=1 --config jest.smoke.config.ts --verbose --no-cache",
    "test:migration-usj": "cd .. && node --test migration/usj-structure.test.mjs",
    "test:migration-burrito-to-ptf": "cd .. && node --test migration/05-burrito-to-ptf.test.mjs",
    "test:coverage": "jest --coverage",
    "format": "prettier --config ../.prettierrc.yaml --ignore-path ../.prettierignore --write \"**/*.{js,ts,tsx,json,css,md,mdx,html}\"",
    "format:check": "prettier --config ../.prettierrc.yaml --ignore-path ../.prettierignore --check \"**/*.{js,ts,tsx,json,css,md,mdx,html}\"",
    "lint": "eslint . --cache-location node_modules/.cache/eslint --quiet",
    "typecheck": "tsc --noEmit -p tsconfig.app.json --composite false",
    "validate": "npm-run-all --parallel lint build",
    "cy:open-local": "cypress open --e2e --browser chrome --config-file cypress/config/local.config.ts",
    "cy:run-local": "cypress run --e2e --browser chrome --config-file cypress/config/local.config.ts",
    "cy:open-ct": "cypress open --component --browser chrome --config-file cypress/config/local.config.ts",
    "cy:run-ct": "cypress run --component --browser chrome --config-file cypress/config/local.config.ts --expose grepTags=-@known-defect",
    "cy:run-ct-known-defects": "cypress run --component --browser chrome --config-file cypress/config/local.config.ts --expose grepTags=@known-defect",
    "cy:run-ct-all": "cypress run --component --browser chrome --config-file cypress/config/local.config.ts",
    "cy:run-ct-smoke": "cypress run --component --browser chrome --config-file cypress/config/local.config.ts --spec \"src/burrito/BurritoWrapper.cy.tsx,src/components/App/OrgHead.cy.tsx,src/components/PassageDetail/PassageDetailPhraseBackTranslate.cy.tsx,src/components/PassageDetail/mobile/MobileWorkflowSteps.cy.tsx,src/components/Sheet/PassageCard.cy.tsx,src/components/Sheet/PlanView.cy.tsx,src/components/StepEditor/StepEditor.cy.tsx,src/control/RecordButton.cy.tsx,src/routes/SwitchTeams.cy.tsx\" --expose grepTags=@smoke,grepOmitFiltered=true",
    "cy:smoke-specs": "cd .. && node env-config/smokeSpecs.cjs",
    "cy:smoke-specs:write": "cd .. && node env-config/smokeSpecs.cjs --write",
    "cy:ct-deps": "cd .. && node env-config/ctOptimizeDeps.cjs",
    "cy:ct-deps:write": "cd .. && node env-config/ctOptimizeDeps.cjs --write",
    "cy:docker": "docker-compose up --abort-on-container-exit --exit-code-from cypress",
    "cy:docker:build": "docker-compose up --build --abort-on-container-exit --exit-code-from cypress",
    "cy:docker:down": "docker-compose down",
    "devs": "cd .. && node env-config/changeEnv.cjs dev && cd web",
    "devsl": "cd .. && node env-config/changeEnvLocal.cjs dev && cd web",
    "qas": "cd .. && node env-config/changeEnv.cjs qa && cd web",
    "qasl": "cd .. && node env-config/changeEnvLocal.cjs qa && cd web",
    "prods": "cd .. && node env-config/changeEnv.cjs prod && cd web",
    "prodsl": "cd .. && node env-config/changeEnvLocal.cjs prod && cd web"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.30.0",
    "@bugsnag/js": "^8.10.0",
    "@bugsnag/plugin-react": "^8.9.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fingerprintjs/fingerprintjs": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/x-data-grid": "^8.29.5",
    "@mui/x-tree-view": "^8.29.3",
    "@ncdai/react-wheel-picker": "^1.2.3",
    "@orbit/coordinator": "^0.17.0",
    "@orbit/core": "^0.17.0",
    "@orbit/indexeddb": "^0.17.2",
    "@orbit/indexeddb-bucket": "^0.17.0",
    "@orbit/jsonapi": "^0.17.1",
    "@orbit/memory": "^0.17.2",
    "@orbit/records": "^0.17.0",
    "@orbit/serializers": "^0.17.0",
    "@redux-devtools/extension": "^3.3.0",
    "@types/path-browserify": "^1.0.3",
    "@uiw/react-color-colorful": "^2.10.3",
    "@wavesurfer/react": "^1.0.14",
    "@xmldom/xmldom": "^0.8.15",
    "array-move": "^4.0.0",
    "audio-recorder-polyfill": "^0.4.1",
    "axios": "^1.21.1",
    "browser-image-compression": "^2.0.2",
    "electron-updater": "^6.8.12",
    "jszip": "^3.10.2",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.18.1",
    "luxon": "^3.7.2",
    "mui-language-picker": "^2.7.5",
    "path-browserify": "^1.0.1",
    "react": "19.3.1",
    "react-datasheet": "^1.4.12",
    "react-dom": "19.3.1",
    "react-draggable": "^4.7.2",
    "react-file-drop": "^3.1.6",
    "react-icons": "^5.7.0",
    "react-lifecycles-compat": "^3.0.4",
    "react-localization": "^2.1.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.5",
    "react-select": "^5.10.2",
    "react-string-replace": "^1.1.1",
    "react-style-proptype": "^3.2.2",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "remark-gfm": "^4.0.1",
    "styled-components": "^6.6.0",
    "url-parse": "^1.5.10",
    "usfm-grammar-web": "^3.2.1",
    "wavesurfer.js": "^7.12.12",
    "xpath": "^0.0.36"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "exclude": [
      "node_modules",
      "dist",
      "build",
      "out"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@bahmutov/cy-api": "^2.3.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@bugsnag/cli": "^3.10.7",
    "@cypress/grep": "7.0.0",
    "@cypress/vite-dev-server": "^8.0.0",
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@esbuild-plugins/node-modules-polyfill": "^0.2.2",
    "@faker-js/faker": "10.6.0",
    "@testing-library/cypress": "10.1.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/jest": "30.0.0",
    "@types/jwt-decode": "^2.2.1",
    "@types/lodash": "^4.17.27",
    "@types/luxon": "^3.7.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-redux": "^7.1.35",
    "@types/url-parse": "^1.4.11",
    "@types/wavesurfer.js": "^3.3.2",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "@vitejs/plugin-react": "^6.3.0",
    "cypress": "^16.3.0",
    "cypress-data-session": "^3.1.0",
    "cypress-map": "^1.57.1",
    "dotenv": "^17.4.2",
    "esbuild": "^0.27.7",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-cypress": "3.6.0",
    "eslint-plugin-implicit-dependencies": "1.1.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-no-only-tests": "3.4.0",
    "eslint-plugin-prettier": "5.5.7",
    "husky": "4.3.8",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "lint-staged": "16.4.0",
    "npm-run-all2": "8.0.4",
    "prettier": "3.10.0",
    "start-server-and-test": "2.1.5",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^1.3.0"
  },
  "author": {
    "name": "SIL Global",
    "email": "info@sil.org",
    "url": "http://sil.org"
  },
  "build": {
    "appId": "sil.lsdev.audio-project-manager",
    "productName": "Audio Project Manager",
    "copyright": "Copyright © 2020-2026 ${author}"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "allowScripts": {
    "@bugsnag/cli@3.10.7": true,
    "browser-tabs-lock@1.3.0": true,
    "esbuild@0.27.7": true,
    "husky@4.3.8": true,
    "cypress@16.3.0": true,
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  }
}
